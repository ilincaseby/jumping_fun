---
import { Image, getImage } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import { galleryMedia } from '../content/media';
const photos = await Promise.all(galleryMedia.map(async (media) => ({
  ...media,
  full: await getImage({ src: media.image, width: Math.min(1600, media.image.width), format: 'webp', quality: 85 }),
})));
---
<SiteLayout title="Din poze, în lumea lor" description="Fotografii ale echipamentului furnizate de proprietar: vedere frontală, unghi lateral și detalii." active="/galerie/" surface="paper">
  <section class="page-width" aria-labelledby="gallery-title">
    <div class="page-heading">
      <h1 id="gallery-title">Din poze,<br />în lumea lor.</h1>
      <p>Fotografii ale echipamentului, furnizate de proprietar. Deschide-le pentru detalii.</p>
    </div>
    <div class="gallery-grid">
      {photos.map((photo, index) => (
        <figure>
          <a class="gallery-link" href={photo.full.src} data-gallery-image data-alt={photo.alt} data-caption={photo.caption} data-media aria-label={`Mărește fotografia: ${photo.caption}`}>
            <Image src={photo.image} alt={photo.alt} widths={[320, 640, 960, 1280]} sizes={index === 0 ? '(max-width: 700px) 90vw, 50vw' : '(max-width: 700px) 43vw, 25vw'} width={960} format="webp" quality={82} loading={index === 0 ? 'eager' : 'lazy'} />
            <span class="expand-icon"><Icon name="expand" size={18} /></span>
            <span class="media-error">Fotografie indisponibilă.</span>
          </a>
          <figcaption class="caption">{photo.caption}</figcaption>
        </figure>
      ))}
    </div>
    <p class="caption">Unghiuri diferite ale aceluiași echipament, nu evenimente sau recenzii inventate.</p>
  </section>
  <dialog class="lightbox" aria-labelledby="lightbox-caption">
    <div class="dialog-toolbar">
      <p id="lightbox-caption"></p>
      <button class="icon-button" type="button" data-close aria-label="Închide fotografia"><Icon name="close" /></button>
    </div>
    <img data-full-image src={photos[0].full.src} alt={photos[0].alt} width="1600" height="1200" loading="lazy" />
    <p class="field-error" data-lightbox-error role="status" hidden>Fotografia nu s-a putut încărca. Închide și încearcă din nou.</p>
  </dialog>
  <script>
    import '../scripts/gallery';
  </script>
</SiteLayout>
