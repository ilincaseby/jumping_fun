---
import SiteLayout from '../layouts/SiteLayout.astro';
import { business } from '../config/business';
import { contactLinks } from '../lib/business';
import { catalog } from '../content/catalog';
const contacts = contactLinks(business);
---
<SiteLayout title="Hai să pregătim petrecerea" description="Alege modelul, data, localitatea și, opțional, numărul și vârsta copiilor. Continuă pe WhatsApp cu mesajul precompletat." active="/oferta/" surface="paper">
  <section class="form-shell" aria-labelledby="form-title">
    <div class="form-heading">
      <h1 id="form-title">Hai să pregătim<br />petrecerea.</h1>
      <p class="mt-4">Completează detaliile, apoi continuă pe WhatsApp. Tu verifici și trimiți mesajul în aplicație.</p>
    </div>
    <div class="error-summary" data-error-summary tabindex="-1" role="alert" hidden><p>Mai avem câteva detalii de corectat.</p><ul></ul></div>
    <form class="request-form" data-request-form>
      <div class="field">
        <label for="model">Model <span class="font-normal">(opțional)</span></label>
        <select id="model" name="model" aria-describedby="model-error">
          <option value="">Nu am decis încă</option>
          {catalog.map((product) => <option value={product.id}>{product.name}</option>)}
        </select>
        <p class="field-error" id="model-error" hidden></p>
      </div>
      <div class="field">
        <label for="date">Data evenimentului *</label>
        <input id="date" name="date" type="date" required aria-describedby="date-error" />
        <p class="field-error" id="date-error" hidden></p>
      </div>
      <div class="field form-wide">
        <label for="locality">Localitatea *</label>
        <input id="locality" name="locality" autocomplete="address-level2" placeholder="Ex.: București, sector 3" maxlength="140" required aria-describedby="locality-error" />
        <p class="field-error" id="locality-error" hidden></p>
      </div>
      <div class="field">
        <label for="children">Număr de copii <span class="font-normal">(opțional)</span></label>
        <input id="children" name="children" type="text" inputmode="numeric" pattern="[0-9]+" placeholder="Ex.: 12" aria-describedby="children-error children-hint" />
        <p class="field-error" id="children-error" hidden></p>
        <p id="children-hint" class="caption">Estimarea pentru eveniment, nu capacitatea simultană a gonflabilului.</p>
      </div>
      <div class="field">
        <label for="ages">Vârsta sau intervalul de vârstă <span class="font-normal">(opțional)</span></label>
        <input id="ages" name="ages" type="text" maxlength="100" placeholder="Ex.: 6 ani sau 4–8 ani" aria-describedby="ages-error ages-hint" />
        <p class="field-error" id="ages-error" hidden></p>
        <p id="ages-hint" class="caption">Vârsta aproximativă a copiilor, fără nume sau date de naștere.</p>
      </div>
      <div class="field form-wide">
        <label for="details">Detalii <span class="font-normal">(opțional)</span></label>
        <textarea id="details" name="details" maxlength="1500" placeholder="Ce ar fi util de știut despre locul evenimentului?" aria-describedby="details-error details-hint"></textarea>
        <p class="field-error" id="details-error" hidden></p>
        <p id="details-hint" class="caption">Nu include nume sau alte date personale despre copii.</p>
      </div>
      <div class="form-wide form-actions">
        <button class="button" type="button" data-whatsapp-button disabled>Continuă pe WhatsApp</button>
        <a href="/tobogane/" class="caption">Înapoi la tobogane</a>
      </div>
      <p class="form-wide caption">Butonul deschide WhatsApp cu mesajul precompletat; nu îl trimite automat și nu confirmă o rezervare. <a href="/confidentialitate/">Despre utilizarea datelor</a>.</p>
      <p class="form-wide caption" data-whatsapp-status role="status"></p>
      <noscript><p class="form-wide caption">Completarea automată a mesajului necesită JavaScript. Poți folosi direct contactele de mai jos.</p></noscript>
    </form>
    <aside class="contact-details" aria-label="Contact direct">
      <h2>Vorbim despre petrecerea ta.</h2>
      <div class="form-actions mt-4">
        {contacts.phone && <a class="button secondary" href={contacts.phone}>{business.contact.phone}</a>}
        {contacts.whatsapp && <a class="button secondary" href={contacts.whatsapp} target="_blank" rel="noopener noreferrer">Deschide WhatsApp</a>}
      </div>
      {business.legal.name && <p class="mt-4">{business.legal.name}</p>}
      {business.openingHours && <p>Program: {business.openingHours}</p>}
    </aside>
  </section>
  <script>
    import '../scripts/request-form';
  </script>
</SiteLayout>
