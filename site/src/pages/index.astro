---
import SiteLayout from '../layouts/SiteLayout.astro';
import SlideScene from '../components/SlideScene.astro';
import Icon from '../components/Icon.astro';
import { business } from '../config/business';
const area = business.serviceArea.join(' și ');
---
<SiteLayout title={`Închiriere tobogane gonflabile în ${area}`} description={`Închiriază tobogane gonflabile de interior sau exterior în ${area}. Vezi modelele pentru petreceri de copii și cere o ofertă pe WhatsApp.`} active="/">
  <section class="hero page-width" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Bucurie la<br />înălțime.</h1>
      <p class="intro">Tobogane gonflabile de închiriat în {area}, pentru petreceri în interior sau în aer liber.</p>
      <div class="hero-actions">
        <a class="button catalog-cta" href="/tobogane/">Vezi catalogul <Icon name="arrow-right" /></a>
        <a class="button secondary" href="/oferta/">Cere o ofertă</a>
      </div>
      <p class="caption">Disponibilitatea și condițiile se confirmă în ofertă.</p>
    </div>
    <SlideScene />
  </section>
</SiteLayout>
