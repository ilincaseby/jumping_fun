---
import '@fontsource-variable/fredoka';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../config/business';
import { businessStructuredData } from '../lib/business';
import { publicationIssues } from '../lib/publication';
import { publicationMediaRights } from '../content/publication-media';
interface Props { title: string; description: string; active?: string; surface?: 'sky' | 'paper' }
const { title, description, active, surface = 'sky' } = Astro.props;
const canonical = business.siteUrl ? new URL(Astro.url.pathname, business.siteUrl).href : null;
const structuredData = businessStructuredData(business);
const readyForPublication = publicationIssues(business, publicationMediaRights).length === 0;
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#E5F4FF" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <meta name="robots" content={readyForPublication ? 'index, follow' : 'noindex, nofollow'} />
    <title>{title} — {business.brand}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${title} — ${business.brand}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body data-surface={surface}>
    <a class="skip-link" href="#continut">Sari la conținut</a>
    <Header active={active} />
    <main id="continut" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import '../scripts/media-fallback';
    </script>
  </body>
</html>
