---
import { getImage } from 'astro:assets';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { business } from '../config/business';
import { businessStructuredData } from '../lib/business';
import { publicationIssues } from '../lib/publication';
import { publicationMediaRights } from '../content/publication-media';
import sharePhoto from '../assets/products/patrula-xxxl.jpg';
interface Props { title: string; description: string; active?: string; surface?: 'sky' | 'paper'; noindex?: boolean }
const { title, description, active, surface = 'sky', noindex = false } = Astro.props;
const pageTitle = `${title} — ${business.brand}`;
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : null;
const shareImage = canonical ? await getImage({ src: sharePhoto, width: 1000, format: 'jpeg', quality: 82 }) : null;
const shareUrl = shareImage && canonical ? new URL(shareImage.src, canonical).href : null;
const readyForPublication = publicationIssues(business, publicationMediaRights).length === 0;
const structuredData = active === '/' && readyForPublication ? businessStructuredData(business) : null;
---
<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
    <meta name="theme-color" content="#E5F4FF" />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <meta name="robots" content={!readyForPublication ? 'noindex, nofollow' : noindex ? 'noindex, follow' : 'index, follow'} />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={business.brand} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareUrl && shareImage && <>
      <meta property="og:image" content={shareUrl} />
      <meta property="og:image:width" content={shareImage.attributes.width} />
      <meta property="og:image:height" content={shareImage.attributes.height} />
      <meta property="og:image:alt" content="Toboganul gonflabil Patrula Cățelușilor Uriaș XXXL" />
      <meta name="twitter:card" content="summary_large_image" />
    </>}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
  </head>
  <body data-surface={surface}>
    <a class="skip-link" href="#continut">Sari la conținut</a>
    <Header active={active} />
    <main id="continut" tabindex="-1"><slot /></main>
    <Footer />
    <script>
      import '../scripts/media-fallback';
    </script>
  </body>
</html>
