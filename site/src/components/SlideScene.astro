---
import { Image } from 'astro:assets';
import photo from '../assets/scene/patrula-home.webp';
---
<figure class="scene">
  <div class="scene-stage">
    <Image class="scene-photo" src={photo} widths={[320, 640, 900]} sizes="(max-width: 700px) 90vw, 48vw" width={900} format="webp" quality={90} alt="Tobogan gonflabil Patrula Cățelușilor Uriaș XXXL, fotografiat frontal, cu arcade albastre, turn roșu și treaptă galbenă." loading="eager" fetchpriority="high" />
  </div>
</figure>
