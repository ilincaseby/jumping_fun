---
interface Props {
  name: 'arrow-right' | 'arrow-left' | 'close' | 'cube' | 'expand' | 'chevron';
  size?: number;
}
const { name, size = 20 } = Astro.props;
const paths = {
  'arrow-right': 'M4 12h15m-6-6 6 6-6 6',
  'arrow-left': 'M20 12H5m6-6-6 6 6 6',
  close: 'm6 6 12 12M18 6 6 18',
  cube: 'm12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Zm0 9 8-4.5M12 12 4 7.5M12 12v9',
  expand: 'M8 3H3v5m13-5h5v5M3 16v5h5m8 0h5v-5',
  chevron: 'm6 9 6 6 6-6',
};
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  <path d={paths[name]} />
</svg>
